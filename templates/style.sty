% ============================================================
% style.sty — 简历自定义样式宏包（极简纯文本风格，紧凑2页）
% 白底黑字、无图标、左对齐、高密度排版
% 修改本文件即可调整简历外观，所有参数均有中文注释
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2024 Minimal Resume Style]

% --- 依赖宏包 ----------------------------------------------
\usepackage{geometry}       % 页面边距
\usepackage{fontspec}       % XeLaTeX 系统字体
\usepackage{xeCJK}          % 中日韩文字支持
\usepackage[table]{xcolor}  % 颜色（table 选项加载 colortbl）
\usepackage{tikz}           % 仅用于照片占位框
\usepackage{enumitem}       % 列表微调
\usepackage{graphicx}       % 插入照片
\usepackage{fancyhdr}       % 页眉页脚
\usepackage[hidelinks]{hyperref}  % 超链接（无边框）
\usepackage{needspace}      % 防止章节标题孤行
\usepackage{array}          % 表格列格式
\usepackage{fontawesome5}   % Font Awesome 5 图标（TeX Live 本地安装，无需网络）

% ============================================================
% 一、颜色定义
% ============================================================
\definecolor{nameblue}{HTML}{377BB5}      % 姓名颜色
\definecolor{sectionblue}{HTML}{377BB5}   % 标题栏背景色

% ============================================================
% 二、页面布局
% ============================================================
\geometry{
    a4paper,
    top     = 0.4cm,
    bottom  = 0.4cm,
    left    = 1cm,
    right   = 1cm,
}
\pagestyle{empty}

% ============================================================
% 三、字体设置 — 统一无衬线字体
% ============================================================
\setmainfont{Helvetica Neue}
\setCJKmainfont{PingFang SC}
\setCJKmonofont{PingFang SC}

% ============================================================
% 四、基础排版参数
% ============================================================
\linespread{1.3}
\setlength{\parskip}{0em}
\setlength{\parindent}{0pt}
\widowpenalty=10000
\clubpenalty=10000

% ============================================================
% 五、个人信息变量（由 resume.tex 设置）
% ============================================================
\makeatletter
\def\cv@photo{}        \def\photo#1{\def\cv@photo{#1}}
\def\cv@name{}         \def\name#1{\def\cv@name{#1}}
\def\cv@lineA{}        \def\lineA#1{\def\cv@lineA{#1}}
\def\cv@lineB{}        \def\lineB#1{\def\cv@lineB{#1}}

% --- 个人信息头部：文字居中于页面，照片右边缘对齐文字右边界 ---
\newsavebox\cv@photobox
\newcommand{\makecvheader}{%
    \noindent
    % 照片用 \rlap 放在右边界：\rlap 零宽度右伸，\hfill 推到最右
    \rlap{%
        \makebox[\textwidth][l]{%
            \hfill
            \ifx\cv@photo\empty
                \tikz{
                    \node[rectangle,draw=black!30,line width=0.3pt,
                          minimum width=2.2cm,minimum height=2.8cm,
                          fill=black!5] {};
                }
            \else
                \sbox\cv@photobox{\includegraphics[width=2.2cm,height=2.8cm,keepaspectratio]{\cv@photo}}%
                \raisebox{-\dimexpr\ht\cv@photobox/2\relax}{\usebox{\cv@photobox}}%
            \fi
        }%
    }%
    % 文字独立居中
    \makebox[\textwidth][c]{%
        \begin{tabular}[c]{@{}c@{}}
            {\fontsize{20}{26}\selectfont\bfseries\color{nameblue}\cv@name} \\[0.4cm]
            \cv@lineA \\[0.1cm]
            \cv@lineB
        \end{tabular}%
    }%
    \vspace{0.15cm}
}

% ============================================================
% 六、一级章节标题 — 白字蓝底仅包裹文字 + 底部通栏分割线无缝拼接
% 使用 tikz：横线向上延伸 1pt 进入 badge 区域，消除所有视觉间隙
% ============================================================
\newcommand{\cvsection}[1]{%
    \needspace{5\baselineskip}%
    \vspace{0.5em}
    \noindent
    \begin{tikzpicture}[baseline=(text.base)]
        % 通栏横线：向上多画 1pt 与 badge 重叠，杜绝渲染缝隙
        \fill[sectionblue] (0,0) rectangle (\textwidth,2pt);
        % 白字蓝底 badge（加大内边距），底部坐在 (0, 1pt)
        \node[
            fill=sectionblue,
            text=white,
            font=\bfseries,
            inner xsep=6pt,
            inner ysep=5pt,
            anchor=south west,
            outer sep=0pt,
        ] (text) at (0,1pt) {#1};
    \end{tikzpicture}
    \par\vspace{0.15em}%  标题与下方内容间距
}

% ============================================================
% 七、三列对齐宏（左-中-右），用于经历/项目首行，全部加粗
% ============================================================
\newcommand{\cvheading}[3]{%
    \noindent
    \makebox[0.28\textwidth][l]{\textbf{#1}}%
    \makebox[0.44\textwidth][c]{\textbf{#2}}%
    \makebox[0.28\textwidth][r]{\textbf{#3}}\par
}

% ============================================================
% 八、条目宏
% ============================================================
\newcommand{\cvevent}[4]{%
    \vspace{0.3em}
    \cvheading{#1}{#2}{#3}
    \ifx\relax#4\relax\else
        \vspace{0.06em}
        #4
    \fi
}

\newcommand{\cvproject}[4]{%
    \vspace{0.3em}
    \cvheading{#1}{#2}{#3}
    \ifx\relax#4\relax\else
        \vspace{0.06em}
        #4
    \fi
}

% ============================================================
% 九、列表环境
% ============================================================
\setlist[itemize]{
    leftmargin = 1em,
    itemsep    = 0.05em,
    topsep     = 0.06em,
    parsep     = 0em,
    label      = {\tikz[baseline=-0.65ex]{\fill[black] (0,0) circle (2.2pt);}},
    labelsep   = 0.35em,
}

\setlist[enumerate]{
    leftmargin = 2em,
    itemsep    = 0.05em,
    topsep     = 0.06em,
    parsep     = 0em,
    label      = \arabic*.,
    labelsep   = 0.4em,
}

% ============================================================
% 十、辅助宏 — 左对齐，无缩进
% ============================================================
\newcommand{\cvtech}[1]{%
    \noindent\textbf{技术栈：}#1\par\vspace{0.04em}
}

\newcommand{\cvlabeled}[2]{%
    \noindent\textbf{#1}：#2\par\vspace{0.04em}
}
\makeatother

% 超链接颜色（黑色）
\hypersetup{
    colorlinks = true,
    urlcolor   = black,
    linkcolor  = black,
}
