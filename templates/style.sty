% ============================================================
% style.sty — 简历自定义样式宏包
% 本文件定义所有视觉元素：颜色、字体、标题样式、个人信息区布局等
% 修改本文件即可调整简历外观，无需改动其他文件
% 所有参数均有中文注释说明其作用
% ============================================================

% --- 包声明 ------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2024 Resume Style Package]

% --- 依赖宏包 ----------------------------------------------
% geometry: 页面边距设置
% fontspec: XeLaTeX 系统字体选择
% xeCJK: 中日韩文字支持（自动处理中文字体切换）
% xcolor: 颜色定义（with table option for colored rules）
% tikz: 图形绘制（用于标题装饰条、照片等）
% fontawesome5: 图标字体（电话、邮箱等图标）
% titlesec: 自定义章节标题格式
% enumitem: 自定义列表环境
% hyperref: 超链接支持
% fancyhdr: 页眉页脚
\usepackage{geometry}
\usepackage{fontspec}
\usepackage{xeCJK}
\usepackage[table]{xcolor}
\usepackage{tikz}
\usepackage{fontawesome5}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}

% ============================================================
% 一、颜色定义 — 修改此处调整整体配色
% ============================================================
% 主色：用于标题栏、装饰条、姓名等核心元素
\definecolor{primary}{HTML}{2C5282}
% 深色：用于正文文字
\definecolor{textdark}{HTML}{1A202C}
% 灰色：用于日期、次要信息
\definecolor{textgray}{HTML}{718096}
% 浅灰：用于分隔线、背景等
\definecolor{lightgray}{HTML}{E2E8F0}
% 白色：用于负空间
\definecolor{bgwhite}{HTML}{FFFFFF}

% ============================================================
% 二、字体设置 — 修改此处切换字体
% XeLaTeX 通过字体名直接查找系统字体，无需指定路径
% 可用 `fc-list :lang=zh` 查看系统中文字体列表
% ============================================================
% 主字体（西文）：Helvetica Neue，现代无衬线风格
% 如需更换，将 "Helvetica Neue" 替换为其他系统字体名即可
\setmainfont{Helvetica Neue}

% 中文字体：苹方（PingFang SC），macOS 系统自带
% 如需更换，将 "PingFang SC" 替换为其他中文字体名（如 "Songti SC"）
\setCJKmainfont{PingFang SC}

% sans-serif 字体（备用，用于部分 UI 元素）
\setsansfont{Helvetica Neue}

% ============================================================
% 三、页面布局
% ============================================================
% 页面边距：上下 1.5cm，左右 2cm（可调整）
\geometry{
    a4paper,
    top     = 1.5cm,
    bottom  = 1.2cm,
    left    = 2cm,
    right   = 2cm,
}

% 页眉页脚清空
\pagestyle{empty}

% ============================================================
% 四、行距与段落间距
% ============================================================
% 设置行距倍率（1.15 倍行距，兼顾可读性与紧凑）
\linespread{1.15}

% 段落间距
\setlength{\parskip}{0.4em}
\setlength{\parindent}{0pt}

% ============================================================
% 五、个人信息区样式（照片 + 姓名 + 联系方式）
% ============================================================

% 用于存储个人信息的内部变量（由 resume.tex 通过 \name{} 等命令设置）
% 使用 @ 符号需要 \makeatletter 环境，见本文件末尾
\makeatletter
\def\cv@photo{}        \def\photo#1{\def\cv@photo{#1}}
\def\cv@name{}         \def\name#1{\def\cv@name{#1}}
\def\cv@title{}        \def\title#1{\def\cv@title{#1}}
\def\cv@email{}        \def\email#1{\def\cv@email{#1}}
\def\cv@phone{}        \def\phone#1{\def\cv@phone{#1}}
\def\cv@location{}     \def\location#1{\def\cv@location{#1}}
\def\cv@website{}      \def\website#1{\def\cv@website{#1}}
\def\cv@github{}       \def\github#1{\def\cv@github{#1}}
\def\cv@linkedin{}     \def\linkedin#1{\def\cv@linkedin{#1}}

% 绘制个人信息头部：左侧姓名+联系方式，右侧照片
% 照片尺寸：宽 2.8cm，高 3.6cm（标准证件照比例）
\newcommand{\makecvheader}{%
    \begin{minipage}[t]{0.70\textwidth}
        % 姓名 — 大号、加粗、主色
        {\fontsize{28}{34}\selectfont\bfseries\color{primary}\cv@name\par}
        \vspace{0.2cm}
        % 职位/头衔
        {\Large\color{textgray}\cv@title\par}
        \vspace{0.5cm}
        % 联系方式行 — 使用 Font Awesome 图标
        \begin{tabular}{@{}p{0.48\textwidth}@{}p{0.48\textwidth}@{}}
            \ifx\cv@email\empty\else
                \faEnvelope\ {\small\cv@email} &
            \fi
            \ifx\cv@phone\empty\else
                \faPhone\ {\small\cv@phone} \\
            \fi
            \ifx\cv@location\empty\else
                \faMapMarker*\ {\small\cv@location} &
            \fi
            \ifx\cv@website\empty\else
                \faGlobe\ {\small\cv@website} \\
            \fi
            \ifx\cv@github\empty\else
                \faGithub\ {\small\cv@github} &
            \fi
            \ifx\cv@linkedin\empty\else
                \faLinkedin\ {\small\cv@linkedin} \\
            \fi
        \end{tabular}
    \end{minipage}%
    \hfill%
    \begin{minipage}[t]{0.26\textwidth}
        \raggedleft
        \ifx\cv@photo\empty
            % 无照片时显示占位框
            \tikz{
                \node[rectangle,draw=lightgray,line width=1pt,
                      minimum width=2.8cm,minimum height=3.6cm,
                      fill=lightgray!30] {};
            }
        \else
            \includegraphics[width=2.8cm,height=3.6cm,keepaspectratio]{\cv@photo}
        \fi
    \end{minipage}
    \vspace{0.3cm}
    % 头部分隔线
    {\color{primary}\rule{\textwidth}{1.5pt}}
    \vspace{0.6cm}
}
\makeatother

% ============================================================
% 六、章节标题样式
% ============================================================

% 章节标题命令：左侧彩色竖条 + 粗体标题
% 用法：\cvsection{标题文字}
\newcommand{\cvsection}[1]{%
    \vspace{0.8em}
    \noindent
    \begin{tikzpicture}[baseline=(title.base)]
        % 左侧装饰竖条：宽度 3pt，高度与标题匹配，主色
        \fill[primary] (0,0) rectangle (3pt, 0.55cm);
        % 标题文字：粗体、深色、略大
        \node[anchor=west,inner sep=0pt,font=\bfseries\large\color{textdark}]
            (title) at (8pt,0.275cm) {#1};
    \end{tikzpicture}
    \vspace{0.1em}
    % 标题下方细线
    \par\noindent{\color{lightgray}\rule{\textwidth}{0.5pt}}
    \vspace{0.5em}
}

% ============================================================
% 七、条目宏（用于工作经验、教育经历、项目等）
% ============================================================

% 带标题/副标题/日期/描述的条目
% 用法：\cvevent{标题}{副标题}{日期}{描述}
\newcommand{\cvevent}[4]{%
    \vspace{0.4em}
    \noindent
    \begin{minipage}[t]{\textwidth}
        % 第一行：标题（左对齐，加粗） + 日期（右对齐，灰色）
        \textbf{\color{textdark}#1}%
        \hfill%
        {\small\color{textgray}#3}%
        \par
        % 第二行：副标题（灰色，略小）
        \ifx\relax#2\relax\else
            {\small\color{textgray}#2}\par
        \fi
        % 描述：项目符号列表
        \ifx\relax#4\relax\else
            \vspace{0.1em}
            #4
        \fi
    \end{minipage}
    \vspace{0.2em}
}

% 简单条目（仅标题+描述，用于技能、语言等）
% 用法：\cvsimple{标签}{内容}
\newcommand{\cvsimple}[2]{%
    \noindent
    \textbf{\color{textdark}#1}：{\small #2}\par
    \vspace{0.2em}
}

% ============================================================
% 八、列表环境微调
% ============================================================
% 全局紧凑列表 — 减小项目符号与文字的间距
\setlist[itemize]{
    leftmargin = 1.2em,
    itemsep    = 0.15em,
    topsep     = 0.1em,
    parsep     = 0em,
    label      = {\color{primary}\textbullet},
}

% 内联技能标签列表
\newcommand{\skilltags}[1]{%
    \noindent#1\par
}

% ============================================================
% 九、超链接颜色与元数据
% ============================================================
\hypersetup{
    colorlinks = true,
    urlcolor   = primary,
    linkcolor  = primary,
}
