% ============================================================
% cv.latex — 简历框架模板
% 本文件定义简历的整体框架、变量插槽和章节/条目宏。
% 所有视觉样式由 style.sty 提供，本文件仅定义结构和语义命令。
%
% 使用方式：在 resume.tex 中先 \input 本文件，
% 然后设置个人信息变量，最后在 document 环境中调用宏构建内容。
% ============================================================

% ============================================================
% 一、个人信息变量
% 在 resume.tex 中设置这些变量的值，然后调用 \makecvheader
% ============================================================
% 姓名        \name{张三}
% 头衔/职位   \title{高级软件工程师}
% 邮箱        \email{zhangsan@example.com}
% 电话        \phone{+86 138-0000-0000}
% 城市        \location{北京}
% 个人网站    \website{zhangsan.dev}
% GitHub     \github{github.com/zhangsan}
% LinkedIn   \linkedin{linkedin.com/in/zhangsan}
% 照片路径    \photo{assets/photo.png}
%
% 调用 \makecvheader 生成个人信息头部区块

% ============================================================
% 二、章节命令
% \cvsection{章节名称}
% 生成带装饰条的章节标题，如"工作经验"、"教育背景"等
% ============================================================

% ============================================================
% 三、条目命令
% \cvevent{标题}{副标题/机构}{日期}{描述}
%   适用于工作经验、教育经历、项目等需要标题+时间+描述的场景
%   描述部分可包含 itemize 列表等任意 LaTeX 内容
%
% \cvsimple{标签}{内容}
%   适用于技能标签、语言能力等简短的键值对展示
% ============================================================

% ============================================================
% 四、简历构建流程示意（在 resume.tex 的 document 环境中）：
%
% \makecvheader
%
% \cvsection{个人简介}
% 段落文字...
%
% \cvsection{工作经验}
% \cvevent{职位}{公司}{日期}{描述}
% \cvevent{...}{...}{...}{...}
%
% \cvsection{教育背景}
% \cvevent{学位}{学校}{日期}{描述}
%
% \cvsection{技能}
% \cvsimple{编程语言}{Python, Go, Java, ...}
%
% \cvsection{项目}
% \cvevent{项目名}{角色}{日期}{描述}
%
% 上述所有命令均在 style.sty 中定义为视觉样式，
% 如需调整外观（颜色、间距、字体），请修改 style.sty。
% ============================================================
