% ============================================================
% cv.latex — 简历框架模板（极简纯文本风格）
% 本文件定义简历的整体框架、变量插槽和章节/条目宏的使用说明
%
% 使用方式：在 resume.tex 中先 \input{style.sty} 再 \input{本文件}，
% 设置个人信息变量后，在 document 环境调用宏构建内容
% ============================================================

% ============================================================
% 一、个人信息变量（在 resume.tex 中设置）
% ============================================================
% \name{姓名}          — 第1行，加粗大号
% \lineA{电话 | 邮箱 | GitHub}   — 第2行，| 分隔
% \lineB{籍贯 | 城市 | 年龄}    — 第3行，| 分隔
% \photo{路径}          — 证件照（右侧）
%
% 调用 \makecvheader 生成头部

% ============================================================
% 二、章节命令
% \cvsection{标题}     — 加粗、独立成行、前后留空
% ============================================================

% ============================================================
% 三、条目命令
% \cvevent{角色}{公司/机构}{日期}{内容}
%   首行：角色（加粗）  公司  日期
%   内容：itemize 列表或段落
%
% \cvproject{项目名}{公司}{日期}{内容}
%   格式同 \cvevent，用于项目经历
%
% \cvdesc{文字}        — 缩进段落
% \cvtech{技术}        — 缩进 + "技术栈："加粗标签
% \cvlabeled{标签}{文字} — 缩进 + "标签："加粗
% ============================================================
